# CDA Backupper configuration
# Copy this file to .env and fill in the values.

# Path where the Delta app stores setups (source)
SOURCE_PATH=C:\Users\YourName\Documents\Assetto Corsa Competizione\Setups

# Path where backups will be written (destination)
DESTINATION_PATH=C:\Users\YourName\Documents\CDA-Backups

# How often to run the backup, in seconds (e.g. 60 = every minute)
INTERVAL_SECONDS=60
